    },
    {
      "name": "guards",
      "description": "Hooks that block what cannot be undone: credentials written into files, destructive commands, skipped git hooks, raw merges of stacked PRs and backticks in inline payloads. Plus a skill to turn your own rules into hooks, safe merging, dependency upgrades and a dependency security audit for any ecosystem.",
      "version": "0.3.0",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
