    {
      "name": "verification",
      "description": "Prove work is correct: a mutation harness, a hostile evaluator, test-driven development, flaky-test diagnosis, database migration review, a CI cost method, review triage that decides which findings are worth fixing, bug fixing from runtime evidence, a generated skill that proves changes in the running app, metric hill climbing on a harness proven sensitive, blind checks of whether a skill change changes behaviour, and hooks that stop tests being weakened and \"done\" being claimed without a check.",
      "version": "0.7.0",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
