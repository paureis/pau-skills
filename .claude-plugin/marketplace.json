    {
      "name": "agent-orchestration",
      "description": "Working with subagents: a hook that stops agents from ending their turn idle, an operating methodology where no agent certifies its own work, an evidence-only codebase oracle, parallel work in separate git worktrees, a lean one-subagent-at-a-time way of working that adjusts to your usage budget, and an arena where a blind judge helps pick among several attempts.",
      "version": "0.5.1",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
