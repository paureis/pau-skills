{
  "name": "pau-skills",
  "description": "Claude Code skills and hooks for disciplined agent work in any language: session rituals, verification, subagent orchestration, guards and planning.",
  "owner": {
    "name": "Alvaro Reis",
    "url": "https://github.com/paureis"
  },
  "plugins": [
    {
      "name": "pau-skills",
      "description": "Everything in this marketplace as one plugin: every skill and every hook from session-discipline, verification, agent-orchestration, guards and planning. Install this or the individual plugins, not both.",
      "version": "0.5.0",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
      "repository": "https://github.com/paureis/pau-skills",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "skills",
        "hooks",
        "guards",
        "verification",
        "planning",
        "sessions"
      ],
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/session-discipline/",
        "./skills/verification/",
        "./skills/agent-orchestration/",
        "./skills/guards/",
        "./skills/planning/"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/roadmap.mjs\"",
                "timeout": 15
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/branch-context.mjs\"",
                "timeout": 15
              }
            ]
          },
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/compact-snapshot.mjs\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/compact-snapshot.mjs\"",
                "timeout": 15
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verification/test-tamper-guard.mjs\"",
                "timeout": 5
              }
            ]
          },
          {
            "matcher": "Agent|Task",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-orchestration/no-idle.mjs\"",
                "timeout": 5
              }
            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/block-inline-backtick-payload.mjs\"",
                "timeout": 5
              }
            ]
          },
          {
            "matcher": "Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/merge-guard.mjs\"",
                "timeout": 5
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/destructive-guard.mjs\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/no-verify-guard.mjs\"",
                "timeout": 5
              }
            ]
          },
          {
            "matcher": "Write|Edit|MultiEdit|NotebookEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/secret-guard.mjs\"",
                "timeout": 5
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verification/verify-before-done.mjs\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-orchestration/no-idle.mjs\"",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "session-discipline",
      "description": "Start every session from the written roadmap and the git state, keep the facts a compaction loses, and close in a fixed order: retrospective, roadmap and log, handoff, commit. Plus an instruction-file audit, a guided project setup for new users, and a router over every skill.",
      "version": "0.4.0",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
      "repository": "https://github.com/paureis/pau-skills",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "retrospective",
        "handoff",
        "session",
        "roadmap",
        "hooks",
        "claude-md"
      ],
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/session-discipline/"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/roadmap.mjs\"",
                "timeout": 15
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/branch-context.mjs\"",
                "timeout": 15
              }
            ]
          },
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/compact-snapshot.mjs\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-discipline/compact-snapshot.mjs\"",
                "timeout": 15
              }
            ]
          }
        ]
      }
    },
    {
      "name": "verification",
      "description": "Prove work is correct: a mutation harness, a hostile evaluator, test-driven development, flaky-test diagnosis, database migration review, a CI cost method, and hooks that stop tests being weakened and \"done\" being claimed without a check.",
      "version": "0.4.0",
      "author": {
        "name": "Alvaro Reis",
        "url": "https://github.com/paureis"
      },
      "homepage": "https://github.com/paureis/pau-skills",
      "repository": "https://github.com/paureis/pau-skills",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "mutation-testing",
        "evaluation",
        "tdd",
        "testing",
        "ci",
        "flaky-tests",
        "migrations",
        "hooks"
      ],
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/verification/"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verification/test-tamper-guard.mjs\"",
                "timeout": 5
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verification/verify-before-done.mjs\"",
                "timeout": 10
              }
            ]
          }
        ]
      }
    },
    {
      "name": "agent-orchestration",
      "description": "Working with subagents: a hook that stops agents from ending their turn idle, an operating methodology where no agent certifies its own work, an evidence-only codebase oracle, and parallel work in separate git worktrees.",
